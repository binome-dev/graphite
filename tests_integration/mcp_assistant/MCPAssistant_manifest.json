            "routes": [
              {
                "topic": "function_result_topic",
                "when": {
                  "ref": "grafi.nodes.conditions:always_true"
                }
              }
            ]
          }
        },
        "OpenAIOutputNode": {
          "class": "grafi.nodes.node:Node",
          "node_id": "dfc26269e1a04464b21d84b0d82b2aaf",
          "name": "OpenAIOutputNode",
          "type": "LLMNode",
