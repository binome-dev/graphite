                  "type": "object",
                  "properties": {
                    "name": {
                      "description": "",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "output_schema": null
              }
            ],
            "functions": {},
            "on_error": "return",
            "mcp_config": {
              "mcpServers": {
                "hello": {
                  "url": "http://localhost:8000/mcp/",
                  "transport": "http"
                }
              }
            },
            "resources": [],
            "prompts": []
          },
          "oi_span_type": "CHAIN",
          "subscribed_expressions": [
            {
              "topic": "function_call_topic"
