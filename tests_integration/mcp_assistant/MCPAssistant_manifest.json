          "subscribed_expressions": [
            {
              "topic": "function_result_topic"
            }
          ],
          "publisher_router": {
            "routes": [
              {
                "topic": "agent_output_topic",
                "when": {
                  "ref": "grafi.nodes.conditions:has_text_response"
                }
              }
            ]
          }
        }
