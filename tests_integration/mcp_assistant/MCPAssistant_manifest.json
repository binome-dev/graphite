    "assistant_id": "98a8dbfd10524c8db8f29554b060e066",
    "name": "MCPAssistant",
    "type": "SimpleFunctionCallAssistant",
    "oi_span_type": "AGENT",
    "workflow": {
      "class": "grafi.workflows.impl.event_driven_workflow:EventDrivenWorkflow",
      "oi_span_type": "AGENT",
      "workflow_id": "c4698049d286415ba2fa27ca72b61ed8",
      "name": "simple_function_call_workflow",
      "type": "EventDrivenWorkflow",
      "nodes": {
        "OpenAIInputNode": {
          "class": "grafi.nodes.node:Node",
          "node_id": "06d74dc8f77e4839a852557854e96575",
          "name": "OpenAIInputNode",
          "type": "LLMNode",
          "tool": {
            "class": "grafi.tools.llms.impl.openai_tool:OpenAITool",
            "tool_id": "421fb660089c4ee4a1eaabebba06ed47",
            "name": "UserInputLLM",
            "type": "OpenAITool",
            "oi_span_type": "LLM",
            "system_message": null,
            "api_key": {
              "env": "OPENAI_API_KEY"
            },
            "model": "gpt-4o-mini",
            "chat_params": {},
            "is_streaming": true,
            "structured_output": false,
            "base_url": null,
            "reasoning_effort": null,
            "verbosity": null
          },
          "oi_span_type": "CHAIN",
          "subscribed_expressions": [
            {
              "topic": "agent_input_topic"
            }
